# --- Required ---
# Anthropic API key. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional ---
# Claude model used for extraction, risk analysis, and playbook comparison.
# Defaults to claude-sonnet-5. Use claude-opus-5 for maximum accuracy.
ANTHROPIC_MODEL=claude-sonnet-5
